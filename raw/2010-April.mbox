>    chromo<-order.chromos[i]
>    the.counts<-rbind(the.counts,cbind(chromo,start(the.exons[chromo]),end(the.exons[chromo]), viewSums(regionViews[[chromo]]) ))
> }
> colnames(the.counts)<- c("chr","start","end","count")
