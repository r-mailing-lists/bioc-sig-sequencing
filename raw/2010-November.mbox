>                c(6,5+6+6+5,5+6+5+4)))
> T <- factor(rep( c("T00","T06","T12","T24","T48","T06","T12","T24","T48"), 
>                c(6,5,6,6,5,5,6,5,4)))
> 
> ... and then a design matrix:
